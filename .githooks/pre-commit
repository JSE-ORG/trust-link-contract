#!/bin/sh

# Pre-commit hook: runs exactly the checks CI runs, via the same make targets,
# so a commit that passes here passes in CI (and vice versa). See the
# "Building & Testing" section of CONTRIBUTING.md for the canonical commands.
#
# Install via: make setup

set -e

echo "Running pre-commit checks..."

# Check formatting
echo "Checking code formatting..."

if ! make fmt-check; then
    echo ""
    echo "ERROR: Code is not formatted correctly."
    echo "Run 'make fmt' to fix formatting, then re-add your files."
    exit 1
fi

echo "Formatting check passed."

# Run clippy (canonical scope: cargo clippy --lib + pedantic, see Makefile)
echo "Running clippy lints (canonical scope: make clippy)..."

if ! make clippy; then
    echo ""
    echo "ERROR: Clippy found lint errors."
    echo "Fix the clippy warnings above, then re-add your files."
    echo "CI runs the same 'make clippy' gate — see CONTRIBUTING.md."
    exit 1
fi

echo "Clippy check passed."

echo "Pre-commit checks complete. Proceeding with commit."
