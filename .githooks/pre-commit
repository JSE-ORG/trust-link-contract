#!/bin/sh

# Pre-commit hook: runs the same lint/format checks as CI for the library code.
# Fuzz targets are intentionally checked separately via `make fuzz-check`.
# Install via: make setup

set -e

echo "Running pre-commit checks..."

# Check formatting
echo "Checking code formatting..."

if ! cargo fmt --all -- --check; then
    echo ""
    echo "ERROR: Code is not formatted correctly."
    echo "Run 'cargo fmt --all' to fix formatting, then re-add your files."
    exit 1
fi

echo "Formatting check passed."

# Run clippy
# Keep this in sync with `.github/workflows/ci.yml` and the `make clippy` target.
echo "Running clippy lints..."

if ! cargo clippy --lib -- -D warnings; then
    echo ""
    echo "ERROR: Clippy found lint errors."
    echo "Fix the clippy warnings above, then re-add your files."
    exit 1
fi

echo "Clippy check passed."

echo "Pre-commit checks complete. Proceeding with commit."
